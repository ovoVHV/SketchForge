+# RUN: ld.lld -r %t/main.crel.o -o %t/crel.o
+# RUN: llvm-readelf -r -x .data.ptr %t/crel.o | FileCheck %s --check-prefix=RAW-CREL
+# RUN: ld.lld %t/crel.o --image-base=0 --section-start=.data=0x1000 --section-start=.rodata=0x2000 -o %t/crel-linked
+# RUN: llvm-readelf -x .data %t/crel-linked | FileCheck %s --check-prefix=NOGC
+
+## A final link keeps relocated contents, so retained relocations need a
+## normalized explicit addend for post-link consumers.
+# RUN: ld.lld %t/main.o --emit-relocs --image-base=0 --section-start=.data=0x1000 --section-start=.rodata=0x2000 -o %t/emit
+# RUN: llvm-readelf -r -x .data %t/emit | FileCheck %s --check-prefix=EMIT-RELA
+# RUN: ld.lld %t/main.crel.o --emit-relocs --image-base=0 --section-start=.data=0x1000 --section-start=.rodata=0x2000 -o %t/emit-crel
+# RUN: llvm-readelf -r -x .data %t/emit-crel | FileCheck %s --check-prefix=EMIT-CREL
+# RUN: ld.lld %t/main.crel.o %t/extra.o --emit-relocs --image-base=0 --section-start=.data=0x1000 --section-start=.rodata=0x2000 -o %t/emit-mixed
+# RUN: llvm-readelf -r %t/emit-mixed | FileCheck %s --check-prefix=EMIT-MIXED
+
+## DWARF consumers inspect relocations before relocateNonAlloc writes output.
+# RUN: ld.lld %t/main.o --gdb-index -e _start --image-base=0 --section-start=.text=0x1000 -o %t/gdb-index
+# RUN: llvm-dwarfdump --gdb-index %t/gdb-index | FileCheck %s --check-prefix=GDB
+# RUN: ld.lld %t/main.o --debug-names -e _start -o %t/debug-names
+# RUN: llvm-dwarfdump --debug-names %t/debug-names | FileCheck %s --check-prefix=DEBUG-NAMES
+
+# RAW-RELA:      Relocation section '.rela.data.ptr'
+# RAW-RELA:      R_XTENSA_32 {{.*}} .rodata.str1.1 + 0
+# RAW-RELA:      Hex dump of section '.data.ptr':
+# RAW-RELA-NEXT: 0x00000000 06000000
+
+# RAW-CREL:      Relocation section '.crel.data.ptr'
+# RAW-CREL:      R_XTENSA_32 {{.*}} .rodata.str1.1 + 0
+# RAW-CREL:      Hex dump of section '.data.ptr':
+# RAW-CREL-NEXT: 0x00000000 06000000
+
+# NOGC:      Hex dump of section '.data':
+# NOGC-NEXT: 0x00001000 06200000
+
+# GC:      Hex dump of section '.data':
+# GC-NEXT: 0x00001000 00200000
+# GC:      String dump of section '.rodata':
+# GC-NEXT: [     0]  target
+# GC-NOT:  first
+
+# EMIT-RELA:      Relocation section '.rela.data'
+# EMIT-RELA:      R_XTENSA_32 {{.*}} .rodata + 6
+# EMIT-RELA:      Hex dump of section '.data':
+# EMIT-RELA-NEXT: 0x00001000 06200000
+
+# EMIT-CREL:      Relocation section '.crel.data'
+# EMIT-CREL:      R_XTENSA_32 {{.*}} .rodata + 6
+# EMIT-CREL:      Hex dump of section '.data':
+# EMIT-CREL-NEXT: 0x00001000 06200000
+
+# EMIT-MIXED: Relocation section '.crel.data'
+# EMIT-MIXED: R_XTENSA_32 {{.*}} extra_target + 3
+
+# GDB:      Address area offset = {{.*}}, has 1 entries:
+# GDB-NEXT: Low/High address = [0x1006, 0x1007) (Size: 0x1), CU id = 0
+
+# DEBUG-NAMES:      .debug_names contents:
+# DEBUG-NAMES-NOT:  "wrong"
+# DEBUG-NAMES:      String: {{.*}} "good"
+# DEBUG-NAMES-NOT:  "wrong"
+
+#--- main.s
+  .section .rodata.str1.1,"aMS",@progbits,1
+  .asciz "first"
+  .asciz "target"
+
+  .section .data.ptr,"aw",@progbits
+  .global ptr
+  .type ptr,@object
+ptr:
+  .long 6
+  .reloc ptr, R_XTENSA_32, .rodata.str1.1
+  .size ptr, .-ptr
+
+  .text
+  .global _start
+  .type _start,@function
+_start:
+.Lfunc_begin0:
+  .zero 8
+.Lfunc_end0:
+  .size _start, .-_start
+
+  .section .debug_abbrev,"",@progbits
+  .byte 1                       # DW_TAG_compile_unit
+  .byte 17
+  .byte 1                       # DW_CHILDREN_yes
+  .byte 3                       # DW_AT_name, DW_FORM_strp
+  .byte 14
+  .byte 17                      # DW_AT_low_pc, DW_FORM_addr
+  .byte 1
+  .byte 18                      # DW_AT_high_pc, DW_FORM_data4
+  .byte 6
+  .byte 0
+  .byte 0
+  .byte 2                       # DW_TAG_subprogram
+  .byte 46
+  .byte 0                       # DW_CHILDREN_no
+  .byte 3                       # DW_AT_name, DW_FORM_strp
+  .byte 14
+  .byte 17                      # DW_AT_low_pc, DW_FORM_addr
+  .byte 1
+  .byte 18                      # DW_AT_high_pc, DW_FORM_data4
+  .byte 6
+  .byte 63                      # DW_AT_external, DW_FORM_flag_present
+  .byte 25
+  .byte 0
+  .byte 0
+  .byte 0
+
+  .section .debug_str,"MS",@progbits,1
+  .asciz "wrong"
+  .asciz "good"
+
+  .section .debug_info,"",@progbits
+.Lcu_begin0:
+  .long .Ldebug_info_end0-.Ldebug_info_start0
+.Ldebug_info_start0:
+  .short 4
+  .long 0                       # .debug_abbrev starts at zero
+  .byte 4                       # address size
+  .byte 1                       # compile unit DIE
+.Lcu_name:
+  .long 6
+  .reloc .Lcu_name, R_XTENSA_32, .debug_str
+.Lcu_low_pc:
+  .long 6
+  .reloc .Lcu_low_pc, R_XTENSA_32, _start
+  .long 1
+.Lsubprogram_die:
+  .byte 2                       # subprogram DIE
+.Lsubprogram_name:
+  .long 6
+  .reloc .Lsubprogram_name, R_XTENSA_32, .debug_str
+  .long _start
+  .long .Lfunc_end0-.Lfunc_begin0
+  .byte 0                       # end of compile unit children
+.Ldebug_info_end0:
+
+  .section .debug_names,"",@progbits
+  .long .Lnames_end0-.Lnames_start0
+.Lnames_start0:
+  .short 5
+  .short 0
+  .long 1                       # compilation unit count
+  .long 0                       # local type unit count
+  .long 0                       # foreign type unit count
+  .long 1                       # bucket count
+  .long 1                       # name count
+  .long .Lnames_abbrev_end0-.Lnames_abbrev_start0
+  .long 8
+  .ascii "LLVM0700"
+  .long .Lcu_begin0
+  .long 1                       # bucket 0
+  .long 2090299758              # DJB hash of "good"
+.Lname_string_offset:
+  .long 6
+  .reloc .Lname_string_offset, R_XTENSA_32, .debug_str
+  .long .Lname_entry-.Lnames_entries0
+.Lnames_abbrev_start0:
+  .byte 1                       # abbreviation code
+  .byte 46                      # DW_TAG_subprogram
+  .byte 3                       # DW_IDX_die_offset
+  .byte 19                      # DW_FORM_ref4
+  .byte 4                       # DW_IDX_parent
+  .byte 25                      # DW_FORM_flag_present
+  .byte 0
+  .byte 0
+  .byte 0
+.Lnames_abbrev_end0:
+.Lnames_entries0:
+.Lname_entry:
+  .byte 1
+  .long .Lsubprogram_die-.Lcu_begin0
+  .byte 0
+  .p2align 2, 0
+.Lnames_end0:
+
+#--- extra.s
+  .section .rodata.extra,"a",@progbits
+  .global extra_target
+extra_target:
+  .byte 0
+
+  .section .data.extra,"aw",@progbits
+  .global ptr2
+  .type ptr2,@object
+ptr2:
+  .long 3
+  .reloc ptr2, R_XTENSA_32, extra_target
+  .size ptr2, .-ptr2
