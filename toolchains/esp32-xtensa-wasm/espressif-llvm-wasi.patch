+int64_t Xtensa::adjustRelocationAddend(const uint8_t *buf, RelType type,
+                                      int64_t addend) const {
+  // Xtensa RELA objects keep the R_XTENSA_32 addend in the relocated word.
+  // Consume it before GC and merge-section offset mapping, matching GNU ld.
+  return type == R_XTENSA_32 ? addend + getImplicitAddend(buf, type) : addend;
+}
