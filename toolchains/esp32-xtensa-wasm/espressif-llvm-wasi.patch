--- a/llvm/test/CodeGen/Xtensa/add_shifted_imm.ll
+++ b/llvm/test/CodeGen/Xtensa/add_shifted_imm.ll
@@ -47,3 +47,38 @@ define i64 @test_4(i32 %v) {
   %res = zext i32 %addres to i64
   ret i64 %res
 }
+
+; Reassociation turns this into add (shl %v, 1), 8192. The shifted addend
+; must use the constant pool so ADDX2 selection cannot strand the constant.
+define i32 @test_reassociated(i32 %v) {
+; CHECK-LABEL: test_reassociated:
+; CHECK:       # %bb.0:
+; CHECK:       l32r a8, .LCPI4_0
+; CHECK:       addx2 a2, a2, a8
+; CHECK:       ret
+  %x = add i32 %v, 4096
+  %y = add i32 %x, %x
+  ret i32 %y
+}
+
+define i32 @test_scaled_shift2(i32 %v) {
+; CHECK-LABEL: test_scaled_shift2:
+; CHECK:       # %bb.0:
+; CHECK:       l32r a8, .LCPI5_0
+; CHECK:       addx4 a2, a2, a8
+; CHECK:       ret
+  %scaled = shl i32 %v, 2
+  %sum = add i32 %scaled, 8192
+  ret i32 %sum
+}
+
+define i32 @test_scaled_shift3(i32 %v) {
+; CHECK-LABEL: test_scaled_shift3:
+; CHECK:       # %bb.0:
+; CHECK:       l32r a8, .LCPI6_0
+; CHECK:       addx8 a2, a2, a8
+; CHECK:       ret
+  %scaled = shl i32 %v, 3
+  %sum = add i32 %scaled, 16384
+  ret i32 %sum
+}
