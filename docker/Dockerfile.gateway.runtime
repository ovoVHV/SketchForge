# syntax=docker/dockerfile:1

# Trial image assembled from locally verified TypeScript output and the staged
# browser release. No compiler Worker or Arduino CLI is installed in this image.
FROM node:24-bookworm-slim AS production-dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/server/package.json packages/server/
RUN npm ci --omit=dev --omit=optional --ignore-scripts

FROM node:24-bookworm-slim
RUN groupadd --gid 10001 arduinofast \
    && useradd --uid 10001 --gid arduinofast --no-create-home \
         --home-dir /nonexistent --shell /usr/sbin/nologin arduinofast \
    && install -d -o arduinofast -g arduinofast -m 0750 \
         /var/afartifacts /var/aflibraries /run/arduinofast

WORKDIR /app
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY packages/core/dist ./packages/core/dist
COPY packages/core/package.json ./packages/core/
COPY packages/server/dist ./packages/server/dist
COPY packages/server/package.json ./packages/server/
COPY boards ./boards
COPY packages/web/gateway-public ./packages/web/public
COPY package.json ./

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    AF_ARTIFACT_DIR=/var/afartifacts \
    AF_LIBRARY_STORE_DIR=/var/aflibraries

VOLUME ["/var/afartifacts"]
USER 10001:10001
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "packages/server/dist/gateway.js"]
