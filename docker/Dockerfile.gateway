# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/server/package.json packages/server/
RUN npm ci --ignore-scripts
COPY tsconfig.json tsconfig.base.json ./
COPY packages/core ./packages/core
COPY packages/server ./packages/server
COPY packages/web/browser-avr ./packages/web/browser-avr
COPY packages/web/browser-toolchain ./packages/web/browser-toolchain
COPY packages/web/public ./packages/web/public
COPY docker/gateway-static-allowlist.json ./docker/gateway-static-allowlist.json
COPY scripts/audit-ck-active-release.mjs ./scripts/audit-ck-active-release.mjs
COPY scripts/build-browser-avr.mjs ./scripts/build-browser-avr.mjs
COPY scripts/stage-gateway-public.mjs ./scripts/stage-gateway-public.mjs
RUN npx tsc -b --force packages/core packages/server \
    && npm run build:browser-avr -- --gateway-release \
    && node scripts/stage-gateway-public.mjs --stage packages/web/gateway-public

FROM node:24-bookworm-slim AS production-dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/server/package.json packages/server/
RUN npm ci --omit=dev --ignore-scripts

FROM node:24-bookworm-slim
RUN groupadd --gid 10001 sketchforge \
    && useradd --uid 10001 --gid sketchforge --no-create-home \
         --home-dir /nonexistent --shell /usr/sbin/nologin sketchforge \
    && install -d -o sketchforge -g sketchforge -m 0750 \
         /var/afartifacts /var/aflibraries /run/sketchforge

WORKDIR /app
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/packages/core/package.json ./packages/core/
COPY --from=build /app/packages/server/dist ./packages/server/dist
COPY --from=build /app/packages/server/package.json ./packages/server/
COPY boards ./boards
COPY --from=build /app/packages/web/gateway-public ./packages/web/public
COPY package.json ./

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    AF_ARTIFACT_DIR=/var/afartifacts \
    AF_LIBRARY_STORE_DIR=/var/aflibraries

VOLUME ["/var/afartifacts"]
USER 10001:10001
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "packages/server/dist/gateway.js"]
