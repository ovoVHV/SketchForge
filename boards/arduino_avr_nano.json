{
  "fqbn": "arduino:avr:nano",
  "name": "Arduino Nano",
  "arch": "avr",
  "flashTotal": 30720,
  "ramTotal": 2048,
  "upload": {
    "protocol": "stk500v1",
    "speed": 115200,
    "speedByOption": {
      "cpu": {
        "atmega328": 115200,
        "atmega328old": 57600,
        "atmega168": 19200
      }
    }
  },
  "options": [
    {
      "id": "cpu",
      "label": "处理器 / Bootloader",
      "default": "atmega328",
      "values": [
        { "value": "atmega328", "label": "ATmega328P（新 bootloader，115200）" },
        { "value": "atmega328old", "label": "ATmega328P（老 bootloader，57600）" },
        { "value": "atmega168", "label": "ATmega168（19200）" }
      ]
    },
    {
      "id": "optimize",
      "label": "编译优化",
      "default": "fast",
      "values": [
        { "value": "fast", "label": "快速编译（推荐，编译快约 40%）" },
        { "value": "size", "label": "最小体积（开启 LTO，与 Arduino IDE 一致）" }
      ]
    }
  ],
  "pins": [
    { "id": "0",  "label": "D0 (RX)",  "caps": ["digital", "uart"] },
    { "id": "1",  "label": "D1 (TX)",  "caps": ["digital", "uart"] },
    { "id": "2",  "label": "D2",       "caps": ["digital"] },
    { "id": "3",  "label": "D3 (~)",   "caps": ["digital", "pwm"] },
    { "id": "4",  "label": "D4",       "caps": ["digital"] },
    { "id": "5",  "label": "D5 (~)",   "caps": ["digital", "pwm"] },
    { "id": "6",  "label": "D6 (~)",   "caps": ["digital", "pwm"] },
    { "id": "7",  "label": "D7",       "caps": ["digital"] },
    { "id": "8",  "label": "D8",       "caps": ["digital"] },
    { "id": "9",  "label": "D9 (~)",   "caps": ["digital", "pwm"] },
    { "id": "10", "label": "D10 (~SS)", "caps": ["digital", "pwm", "spi"] },
    { "id": "11", "label": "D11 (~MOSI)", "caps": ["digital", "pwm", "spi"] },
    { "id": "12", "label": "D12 (MISO)", "caps": ["digital", "spi"] },
    { "id": "13", "label": "D13 (SCK/LED)", "caps": ["digital", "spi"] },
    { "id": "A0", "label": "A0", "caps": ["digital", "analog_in"] },
    { "id": "A1", "label": "A1", "caps": ["digital", "analog_in"] },
    { "id": "A2", "label": "A2", "caps": ["digital", "analog_in"] },
    { "id": "A3", "label": "A3", "caps": ["digital", "analog_in"] },
    { "id": "A4", "label": "A4 (SDA)", "caps": ["digital", "analog_in", "i2c_sda"] },
    { "id": "A5", "label": "A5 (SCL)", "caps": ["digital", "analog_in", "i2c_scl"] },
    { "id": "A6", "label": "A6（仅模拟输入）", "caps": ["analog_in"] },
    { "id": "A7", "label": "A7（仅模拟输入）", "caps": ["analog_in"] },
    { "id": "LED_BUILTIN", "label": "板载 LED (D13)", "caps": ["digital"] }
  ],
  "build": {
    "mcu": "atmega328p",
    "fCpu": "16000000L",
    "variant": "eightanaloginputs",
    "defines": ["ARDUINO_AVR_NANO", "ARDUINO_ARCH_AVR"],
    "optionEffects": {
      "cpu": {
        "atmega328": { "mcu": "atmega328p", "flashTotal": 30720, "ramTotal": 2048 },
        "atmega328old": { "mcu": "atmega328p", "flashTotal": 30720, "ramTotal": 2048 },
        "atmega168": { "mcu": "atmega168", "flashTotal": 14336, "ramTotal": 1024 }
      }
    },
    "lto": false
  }
}
